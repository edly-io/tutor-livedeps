#!/usr/bin/env python3

import argparse
import datetime
import os
import shutil
import subprocess
import tempfile
import time
import traceback
import zipfile

from django.core.files.base import File
from django.core.files.storage import storages

DEPS_DIR = "/openedx/livedeps/deps"
DEPS_KEY = "livedeps/archive.zip"
TIMESTAMP_FILE = "/openedx/livedeps/last_update_timestamp"
DEPS_ZIP_PATH = os.path.join(tempfile.gettempdir(), DEPS_KEY)
MONITOR_INTERVAL = 60

STORAGE = storages["default"]

def update_local_timestamp():
    """
    This function updates the TIMESTAMP_FILE with the current time.
    """
    now = datetime.datetime.now(tz=datetime.timezone.utc)
    with open(TIMESTAMP_FILE, "w") as f:
        f.write(now.isoformat())
    

def monitor(args=None):
    """
    This function checks if the remote DEPS_KEY has been modified since
    the last download. If it has, it downloads the dependencies again and
    reloads the Granian workers so that they import the new packages.

    If the TIMESTAMP_FILE is empty, that means we have never downloaded
    the dependencies before, so we also download them and update the timestamp.
    """

    if not STORAGE.exists(DEPS_KEY):
        return

    remote_ts = STORAGE.get_modified_time(DEPS_KEY)

    with open(TIMESTAMP_FILE, "r") as f:
        content = f.read().strip()
        if content == "":
            local_ts = None
        else:
            local_ts = datetime.datetime.fromisoformat(content)
    # Flush, since watch runs this in a long-lived process whose output is buffered
    print(f"Local timestamp: {local_ts}, Remote timestamp: {remote_ts}", flush=True)
    if local_ts is None or local_ts < remote_ts:
        download()
        subprocess.run(["reload-granian"], check=True)


def watch(args=None):
    """
    This function runs monitor every MONITOR_INTERVAL seconds. An error, for
    instance when the storage backend is unreachable, is printed and retried
    at the next interval.
    """
    while True:
        time.sleep(MONITOR_INTERVAL)
        try:
            monitor()
        except Exception:
            traceback.print_exc()


def serve(args=None):
    """
    This function is the command of the LMS and CMS containers. It downloads the
    dependencies, starts watch in the background, then replaces itself with
    run-granian, so that Granian runs as PID 1 and reload-granian can reach it.
    """
    try:
        download()
    except Exception:
        # Serve the platform without live dependencies rather than not at all.
        # watch retries the download, since the timestamp file is still empty.
        traceback.print_exc()

    subprocess.Popen(["livedeps", "watch"])
    os.execvp("run-granian", ["run-granian"])


def download(args=None):
    """
    This function downloads the zip file from the storage backend,
    extracts it to DEPS_DIR and updates the TIMESTAMP_FILE.

    The workers keep serving requests during the download, so the archive is
    extracted next to DEPS_DIR and swapped in once complete.
    """
    if not STORAGE.exists(DEPS_KEY):
        return

    new_dir = DEPS_DIR + ".new"
    old_dir = DEPS_DIR + ".old"
    shutil.rmtree(new_dir, ignore_errors=True)
    shutil.rmtree(old_dir, ignore_errors=True)
    os.makedirs(os.path.dirname(DEPS_ZIP_PATH), exist_ok=True)

    with (
        STORAGE.open(DEPS_KEY, "rb") as remote_f,
        open(DEPS_ZIP_PATH, "wb") as local_f,
    ):
        shutil.copyfileobj(remote_f, local_f)

    with zipfile.ZipFile(DEPS_ZIP_PATH, "r") as zip_ref:
        zip_ref.extractall(new_dir)

    os.remove(DEPS_ZIP_PATH)

    if os.path.exists(DEPS_DIR):
        os.rename(DEPS_DIR, old_dir)
    os.rename(new_dir, DEPS_DIR)
    shutil.rmtree(old_dir, ignore_errors=True)

    update_local_timestamp()


def build(args):
    """
    This function installs the packages specified in args.packages
    into DEPS_DIR, zips the directory and uploads it to the storage backend.
    """

    os.makedirs(DEPS_DIR, exist_ok=True)
    if args.packages:
        pip_cmd = [
            "pip",
            "install",
            "--prefix",
            DEPS_DIR,
        ] + args.packages

        subprocess.run(pip_cmd, check=True)

    with tempfile.TemporaryDirectory(prefix="tutor-livedeps-") as zip_dir:
        base = os.path.join(zip_dir, DEPS_KEY)
        archive_path = shutil.make_archive(base[:-4], format="zip", root_dir=DEPS_DIR)

        with open(archive_path, "rb") as f:
            STORAGE.save(DEPS_KEY, File(f))


def main():
    parser = argparse.ArgumentParser(description="Manage livedeps")
    subparsers = parser.add_subparsers(dest="command", required=True)

    monitor_parser = subparsers.add_parser("monitor")
    watch_parser = subparsers.add_parser("watch")
    serve_parser = subparsers.add_parser("serve")
    download_parser = subparsers.add_parser("download")
    build_parser = subparsers.add_parser("build")
    monitor_parser.set_defaults(func=monitor)
    watch_parser.set_defaults(func=watch)
    serve_parser.set_defaults(func=serve)
    download_parser.set_defaults(func=download)
    build_parser.set_defaults(func=build)
    build_parser.add_argument("packages", nargs="*")

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
